TSMC_FILE=./data/raw/dataset_TSMC2014_NYC.txt
TSMC_ENCODING=latin-1
TSMC_CATEGORY_L1_MAP=./configs/foursquare_category_l1_map.json

PROCESSED_ROOT=./data/processed/nyc
RUN_ROOT=./outputs/nyc
TRAIN_END=
VALIDATION_END=
DEFAULT_TIMEZONE_OFFSET_MINUTES=0

BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct
N_COARSE_REGIONS=64
N_FINE_REGIONS=256
MAX_SEQUENCE_LENGTH=50
MIN_HISTORY_LENGTH=19
KEEP_LAST_K_TRAIN=5

CUDA_VISIBLE_DEVICES=0,1
NPROC_PER_NODE=2
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=8
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50

EVAL_GPUS=0,1
EVAL_CUTOFF_LEN=2048
EVAL_MAX_NEW_TOKENS=32
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
EVAL_NO_CACHE=0
